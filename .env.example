# Copy this file to .env.local and fill in the values you have.
# Everything here is optional — the site runs without any of it.
# NEXT_PUBLIC_ variables are exposed to the browser, so never put a secret here.

# ── Lead form endpoint ────────────────────────────────────────────────────
# Where the quote form POSTs its JSON. Leave blank and the form falls back to
# opening the visitor's email client so a lead is never silently lost.
#   Formspree   https://formspree.io/f/xxxxxxx
#   Web3Forms   https://api.web3forms.com/submit
#   GoHighLevel your inbound webhook URL
#   JobNimbus   your Zapier / Make webhook URL
NEXT_PUBLIC_FORM_ENDPOINT=

# ── Online scheduler ──────────────────────────────────────────────────────
# Calendly, GoHighLevel calendar, Housecall Pro, etc. Leave blank to hide
# booking-specific CTAs.
NEXT_PUBLIC_BOOKING_URL=

# ── Google Tag Manager ────────────────────────────────────────────────────
# e.g. GTM-XXXXXXX. Leave blank to load no analytics at all.
NEXT_PUBLIC_GTM_ID=
